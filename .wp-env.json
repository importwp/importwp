{
    "$schema": "https://schemas.wp.org/trunk/wp-env.json",
    "core": null,
    "port": 8888,
    "testsEnvironment": false,
    "phpmyadmin": true,
    "phpmyadminPort": 8081,
    "plugins": [
        "."
    ],
    "config": {
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": true,
        "WP_DEBUG_DISPLAY": false,
        "DISABLE_WP_CRON": true
    },
    "lifecycleScripts": {
        "afterStart": "bash ./bin/install-php-ext.sh"
    }
}